{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hangar",
  "version": "../package.json",
  "identifier": "io.github.hangar-win",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Hangar",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "winmd/Microsoft.Management.Deployment.winmd": "Microsoft.Management.Deployment.winmd"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGNjlFMkRFRkU3RkM5NDMKUldSRHlYLyszdUpwUDQvME85Wk44ck9oT0Y0V2RxNEQwU0tUS05TaGhOeU15Vm1CenNQbm5zRDUK",
      "endpoints": ["https://github.com/hangar-win/hangar-win/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    },
    "shell": {
      "open": "^https://(github\\.com/(Fatih-Sglm|hangar-win/hangar-win)|www\\.linkedin\\.com/in/fatih-saglam)$"
    }
  }
}
